{
  "Version": "2008-10-17",
  "Statement": [
    {
      "Sid": "allowReferConsole",
      "Effect": "Deny",
      "Principal": {
        "IAM": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "s3:::blog.jiabi/*",
        "s3:::886499mir"
      ],
      "Condition": {
        "StringNotMatch": {
          "g:Referer": [
            "jiabi.tech*"
          ]
        }
      }
    },
    {
      "Sid": "publicReadOnlyPolicyStatementId",
      "Effect": "Allow",
      "Principal": {
        "IAM": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "s3:::blog.jiabi/*",
        "s3:::886499mir"
      ]
    },
    {
      "Sid": "publicHeadBucketPolicyStatementId",
      "Effect": "Allow",
      "Principal": {
        "IAM": [
          "*"
        ]
      },
      "Action": [
        "s3:HeadBucket",
        "s3:ListBucket"
      ],
      "Resource": [
        "s3:::blog.jiabi",
        "s3:::886499mir"
      ]
    }
  ]
}