{
  "Version": "2008-10-17",
  "Id": "Policy1569156431345",
  "Statement": [
    {
      "Sid": "publicReadWritePolicyStatementId",
      "Effect": "Allow",
      "Principal": {
        "IAM": [
          "*"
        ]
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObjectVersion",
        "s3:DeleteObject"
      ],
      "Resource": [
        "s3:::24009yyuuud/*",
        "s3:::886499mir"
      ]
    },
    {
      "Sid": "publicHeadBucketPolicyStatementId",
      "Effect": "Allow",
      "Principal": {
        "IAM": [
          "*"
        ]
      },
      "Action": [
        "s3:HeadBucket",
        "s3:ListBucket"
      ],
      "Resource": [
        "s3:::24009yyuuud",
        "s3:::886499mir"
      ]
    }
  ]
}