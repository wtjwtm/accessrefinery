{
  "Version": "2008-10-17",
  "Id": "Policy1570064884614",
  "Statement": [
    {
      "Sid": "publicReadOnlyPolicyStatementId",
      "Effect": "Allow",
      "Principal": {
        "IAM": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "s3:::59aikan/*",
        "s3:::886499mir"
      ]
    },
    {
      "Sid": "publicHeadBucketPolicyStatementId",
      "Effect": "Allow",
      "Principal": {
        "IAM": [
          "*"
        ]
      },
      "Action": [
        "s3:HeadBucket",
        "s3:ListBucket"
      ],
      "Resource": [
        "s3:::59aikan",
        "s3:::886499mir"
      ]
    }
  ]
}